import {
    Button,
    CheckBox,
    ComboBox,
    LineEdit,
    ListView,
    Palette,
    ScrollView,
    TextEdit
} from "std-widgets.slint";

import { Theme } from "theme.slint";
import { PathField } from "components/PathField.slint";
import { PrimaryButton } from "components/PrimaryButton.slint";
import { DangerButton } from "components/DangerButton.slint";
import { StatusLine } from "components/StatusLine.slint";
import { SupportCredit } from "components/SupportCredit.slint";
import { TabBar, TabInfo } from "components/TabBar.slint";

export { TabInfo }

// One inventory row. `event` is the stable key handed back to the callbacks.
export struct TrackEntry {
    event: int,
    kind: int,            // 0 = sound (event) row, 1 = variation row of an expanded sound
    variation: int,       // 1-based variation number on variation rows, else 0
    expanded: bool,       // sound rows: variations currently shown beneath
    group: string,        // Music: category; sounds: group sub-heading; variation rows: "variation N"
    name: string,         // Music: track name; sounds: event name (ui_menu_ok)
    detail: string,       // sounds: source wav of the first variation
    size: string,         // Music: preview file size or "packed"
    status: string,       // "vanilla" | "replace" | "partial"
    replacement: string,  // queued file name, "" when none
    variations: int,      // number of audio files behind this sound
    shared: int,          // other sounds that share audio with this one
    warning: bool,        // may not replace cleanly (bank embeds a copy)
    can-play: bool,       // preview available (music with a loose mp3)
}

export component AppWindow inherits Window {
    title: "OBR Music Tool";
    icon: @image-url("assets/icon.png");
    preferred-width: 1200px;
    preferred-height: 850px;
    min-width: 1000px;
    min-height: 720px;

    in-out property <string> application-version: "";
    in-out property <string> game-path: "";
    in-out property <bool> game-valid: false;
    in-out property <string> game-status: "Choose the Oblivion Remastered installation folder.";
    in-out property <int> game-tone: 0;

    in-out property <[TrackEntry]> track-list: [];
    in-out property <int> staged-count: 0;
    in-out property <[TabInfo]> tabs: [];
    in-out property <int> current-tab: 0;
    in-out property <string> search-text: "";
    in-out property <int> tab-total: 0;      // sounds matching the search in this tab
    in-out property <int> page-index: 0;
    in-out property <int> page-count: 1;
    in-out property <int> page-first: 0;     // 1-based sound numbers shown on this page
    in-out property <int> page-last: 0;

    in-out property <string> status-title: "Ready";
    in-out property <string> status-message: "Choose a game folder, then replace music and sound effects.";
    in-out property <int> status-tone: 0;
    in-out property <string> log-text: "";
    in-out property <bool> build-running: false;
    in-out property <bool> build-complete: false;
    in-out property <string> output-path: "";
    in-out property <string> wwise-path: "";
    in-out property <bool> wwise-valid: false;
    in-out property <string> wwise-status: "Searching for Wwise...";
    in-out property <int> wwise-tone: 0;
    in-out property <bool> needs-refresh: false;
    in-out property <bool> encoding-active: false;
    in-out property <string> encoding-file: "";
    in-out property <float> encoding-progress: 0;
    in-out property <int> playing-event: -1;
    in-out property <int> playing-variation: -1;   // 1-based variation being played, -1 = sound row
    in-out property <string> playing-filename: "";
    in-out property <float> playing-progress: 0;
    in-out property <string> playing-position-text: "0:00";
    in-out property <string> playing-duration-text: "0:00";
    in-out property <bool> playing-paused: false;
    // Copyright reminder shown before Export / Package; `pending-export` remembers which one.
    in-out property <bool> export-warning-visible: false;
    in-out property <string> pending-export: "";
    // Set by the backend at startup when the user ticked "Don't show this again" earlier.
    in-out property <bool> export-warning-dismissed: false;

    out property <bool> can-build: !root.build-running
        && root.staged-count > 0;
    out property <bool> can-restore: !root.build-running
        && root.staged-count > 0;
    out property <bool> is-playing: root.playing-event >= 0;
    out property <bool> is-music-tab: root.current-tab == 0;

    callback choose-game-folder();
    callback find-game();
    callback game-path-edited();
    callback replace-track(int);   // argument: event index
    callback remove-staged(int);   // argument: event index
    callback tab-selected(int);
    callback search-changed();
    callback prev-page();
    callback next-page();
    callback toggle-expand(int);            // event index
    callback replace-variation(int, int);   // event index, 1-based variation
    callback remove-variation(int, int);
    callback play-variation(int, int);
    callback build-pak();
    callback export-pak();
    callback package-mod();
    callback save-playlist();
    callback load-playlist();
    callback export-warning-dismiss();
    callback restore-staging();
    callback open-kofi();
    callback open-output();
    callback copy-log();
    callback play-track(int);      // argument: event index
    callback stop-playback();
    callback toggle-pause();
    callback seek-to(float);
    callback browse-wwise();
    callback wwise-path-edited();

    background: Theme.window-background;

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    function run-export(kind: string) {
        if (kind == "pak") {
            root.export-pak();
        } else if (kind == "zip") {
            root.package-mod();
        }
    }

    function request-export(kind: string) {
        if (root.export-warning-dismissed) {
            root.run-export(kind);
        } else {
            root.pending-export = kind;
            root.export-warning-visible = true;
        }
    }

    changed log-text => {
        if (!live-log.has-focus) {
            live-log.viewport-y = min(0px, live-log.visible-height - live-log.viewport-height);
        }
    }

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Rectangle {
            height: 68px;
            vertical-stretch: 0;
            background: Theme.chrome-background;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 7px;

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                spacing: 20px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: "OBR Music Tool";
                        color: Theme.text-primary;
                        font-size: 23px;
                        font-weight: 700;
                    }

                    Text {
                        text: "Replace music and sound effects in Oblivion Remastered";
                        color: Theme.text-muted;
                        font-size: 12px;
                    }
                }

                VerticalLayout {
                    width: 240px;
                    alignment: center;
                    spacing: 4px;

                    Text {
                        text: "VERSION " + root.application-version;
                        color: Theme.text-muted;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-alignment: right;
                    }

                    StatusLine {
                        align-end: true;
                        text: root.build-running ? "Building pak"
                            : root.game-valid ? "Game connected"
                            : "Setup required";
                        tone: root.build-running ? 2 : root.game-valid ? 1 : 0;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            Rectangle {
                width: 420px;
                horizontal-stretch: 0;
                background: Theme.surface;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: 7px;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    VerticalLayout {
                        min-height: 44px;
                        max-height: 44px;
                        vertical-stretch: 0;
                        spacing: 2px;

                        Text {
                            text: "Setup";
                            color: Theme.text-primary;
                            font-size: 18px;
                            font-weight: 650;
                        }

                        Text {
                            text: "Point to the game, then stage your sounds.";
                            color: Theme.text-muted;
                            font-size: 12px;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        vertical-stretch: 0;
                        background: Theme.border;
                    }

                    VerticalLayout {
                        min-height: 86px;
                        max-height: 86px;
                        vertical-stretch: 0;
                        spacing: 4px;

                        PathField {
                            label: "GAME INSTALLATION";
                            placeholder: "Oblivion Remastered folder";
                            primary-action: "Find game";
                            primary-width: 86px;
                            value <=> root.game-path;
                            enabled: !root.build-running;
                            primary-clicked => { root.find-game(); }
                            edited => { root.game-path-edited(); }
                        }

                        StatusLine {
                            text: root.game-status;
                            tone: root.game-tone;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        vertical-stretch: 0;
                        background: Theme.border;
                    }

                    VerticalLayout {
                        min-height: 86px;
                        max-height: 86px;
                        vertical-stretch: 0;
                        spacing: 4px;

                        PathField {
                            label: "WWISE AUTHORING";
                            placeholder: "Wwise installation folder";
                            primary-action: "Browse";
                            primary-width: 86px;
                            value <=> root.wwise-path;
                            enabled: !root.build-running;
                            primary-clicked => { root.browse-wwise(); }
                            edited => { root.wwise-path-edited(); }
                        }

                        StatusLine {
                            text: root.wwise-status;
                            tone: root.wwise-tone;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        vertical-stretch: 0;
                        background: Theme.border;
                    }

                    if root.encoding-active : VerticalLayout {
                        spacing: 4px;
                        vertical-stretch: 0;

                        Text {
                            text: "ENCODING";
                            color: Theme.text-secondary;
                            font-size: 12px;
                            font-weight: 600;
                        }

                        Text {
                            text: root.encoding-file;
                            color: Theme.warning;
                            font-size: 11px;
                            overflow: elide;
                        }

                        Rectangle {
                            height: 8px;
                            vertical-stretch: 0;
                            background: Theme.surface-raised;
                            border-color: Theme.border;
                            border-width: 1px;
                            border-radius: 4px;

                            Rectangle {
                                x: 1px;
                                y: 1px;
                                width: max(0px, (parent.width - 2px) * root.encoding-progress);
                                height: parent.height - 2px;
                                background: Theme.warning;
                                border-radius: 3px;
                            }
                        }

                        Rectangle {
                            height: 1px;
                            vertical-stretch: 0;
                            background: Theme.border;
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        vertical-stretch: 0;

                        Text {
                            text: "STAGING";
                            color: Theme.text-secondary;
                            font-size: 12px;
                            font-weight: 600;
                        }

                        Text {
                            text: root.staged-count == 0
                                ? "No sounds staged."
                                : root.staged-count == 1
                                    ? "1 sound staged for packaging."
                                    : root.staged-count + " sounds staged for packaging.";
                            color: root.staged-count > 0 ? Theme.success : Theme.text-muted;
                            font-size: 12px;
                        }

                        HorizontalLayout {
                            height: 32px;
                            spacing: 8px;

                            Button {
                                horizontal-stretch: 1;
                                text: "Open playlist...";
                                enabled: !root.build-running && root.game-valid;
                                clicked => { root.load-playlist(); }
                            }

                            Button {
                                horizontal-stretch: 1;
                                text: "Save playlist...";
                                enabled: root.can-build;
                                clicked => { root.save-playlist(); }
                            }
                        }

                        HorizontalLayout {
                            height: 44px;
                            spacing: 8px;

                            PrimaryButton {
                                horizontal-stretch: 1;
                                text: root.build-running ? "Working..." : "Build & install PAK";
                                enabled: root.can-build;
                                clicked => { root.build-pak(); }
                            }

                            DangerButton {
                                width: 80px;
                                text: "Clear all";
                                enabled: root.can-restore;
                                clicked => { root.restore-staging(); }
                            }
                        }

                        HorizontalLayout {
                            height: 44px;
                            spacing: 8px;

                            PrimaryButton {
                                horizontal-stretch: 1;
                                text: "Export PAK";
                                enabled: root.can-build;
                                clicked => { root.request-export("pak"); }
                            }

                            PrimaryButton {
                                horizontal-stretch: 1;
                                text: "Package release ZIP";
                                enabled: root.can-build;
                                clicked => { root.request-export("zip"); }
                            }
                        }

                        Text {
                            text: "Build installs into the game. Export saves a loose PAK. Package bundles a ready-to-upload ZIP (PAK in ~mods layout + README); the ZIP file name becomes the mod name. Playlists remember which file goes on which track, so you can reopen and tweak a mod later.";
                            color: Theme.text-muted;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        background: transparent;
                    }

                    HorizontalLayout {
                        height: 20px;
                        vertical-stretch: 0;
                        spacing: 12px;

                        Text {
                            horizontal-stretch: 1;
                            text: "All operations run locally on this computer.";
                            color: Theme.text-muted;
                            font-size: 11px;
                            overflow: elide;
                        }

                        SupportCredit {
                            clicked => { root.open-kofi(); }
                        }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: Theme.surface;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: 7px;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    HorizontalLayout {
                        height: 60px;
                        vertical-stretch: 0;
                        spacing: 16px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 3px;

                            Text {
                                text: root.status-title;
                                color: root.status-tone == 1 ? Theme.success
                                    : root.status-tone == 2 ? Theme.warning
                                    : root.status-tone == 3 ? Theme.danger
                                    : Theme.text-primary;
                                font-size: 19px;
                                font-weight: 650;
                                overflow: elide;
                            }

                            Text {
                                text: root.status-message;
                                color: Theme.text-secondary;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    HorizontalLayout {
                        height: 32px;
                        vertical-stretch: 0;
                        spacing: 12px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;

                            Text {
                                text: "SOUND INVENTORY";
                                color: Theme.text-secondary;
                                font-size: 12px;
                                font-weight: 600;
                            }
                            Text {
                                text: root.tabs.length == 0 ? ""
                                    : root.tabs[root.current-tab].label + " · " + root.tab-total
                                    + (root.tab-total == 1 ? " sound" : " sounds")
                                    + " · Play previews the original audio"
                                    + (root.is-music-tab ? "" : " · \u{25b8} shows a sound's variations");
                                color: Theme.text-muted;
                                font-size: 10px;
                                overflow: elide;
                            }
                        }

                        LineEdit {
                            width: 240px;
                            height: 28px;
                            placeholder-text: "Search this tab...";
                            text <=> root.search-text;
                            enabled: !root.build-running;
                            edited => { root.search-changed(); }
                        }
                    }

                    TabBar {
                        tabs: root.tabs;
                        current <=> root.current-tab;
                        enabled: !root.build-running;
                        selected(i) => { root.tab-selected(i); }
                    }

                    Rectangle {
                        height: 28px;
                        vertical-stretch: 0;
                        background: Theme.surface-muted;
                        border-color: Theme.border;
                        border-width: 1px;
                        border-radius: 4px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;

                            Text {
                                width: root.is-music-tab ? 80px : 104px;
                                text: root.is-music-tab ? "Category" : "Group";
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: root.is-music-tab ? "Filename" : "Sound";
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Text {
                                width: root.is-music-tab ? 70px : 168px;
                                text: root.is-music-tab ? "Size" : "Source file";
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-alignment: root.is-music-tab ? right : left;
                            }
                            Text {
                                width: 80px;
                                text: "Status";
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                            }
                            Rectangle {
                                width: 136px;
                            }
                        }
                    }

                    if root.tab-total == 0 : Text {
                        text: !root.tabs[root.current-tab].available
                            ? "Dialogue lines are coming in a future update."
                            : root.search-text == ""
                                ? "This tab is empty."
                                : "No sounds match \"" + root.search-text + "\".";
                        color: Theme.text-muted;
                        font-size: 12px;
                        vertical-stretch: 0;
                    }

                    inventory := ListView {
                        vertical-stretch: 1;

                        for entry[index] in root.track-list : Rectangle {
                            height: 34px;
                            background: entry.kind == 1 ? Theme.surface-muted.transparentize(0.5)
                                : touch-row.has-hover ? Theme.surface-raised
                                : transparent;
                            border-radius: 3px;

                            touch-row := TouchArea {}

                            // ---------------- sound row ----------------
                            if entry.kind == 0 : HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;

                                Text {
                                    width: root.is-music-tab ? 80px : 104px;
                                    text: entry.group;
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                HorizontalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;

                                    Rectangle {
                                        width: 16px;
                                        accessible-role: button;
                                        accessible-label: (entry.expanded ? "Collapse " : "Expand ") + entry.name;
                                        accessible-action-default => { root.toggle-expand(entry.event); }
                                        if entry.variations > 1 : Text {
                                            text: entry.expanded ? "\u{25be}" : "\u{25b8}";
                                            color: chevron.has-hover ? Theme.text-primary : Theme.text-muted;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                            width: 16px;
                                            height: 100%;
                                        }
                                        chevron := TouchArea {
                                            enabled: entry.variations > 1;
                                            clicked => { root.toggle-expand(entry.event); }
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 1px;

                                        Text {
                                            text: entry.name;
                                            color: entry.event == root.playing-event && root.playing-variation < 1 ? Theme.success : Theme.text-primary;
                                            font-size: 12px;
                                            font-family: "Consolas";
                                            font-weight: entry.event == root.playing-event && root.playing-variation < 1 ? 700 : 400;
                                            overflow: elide;
                                        }

                                        if entry.replacement != "" : Text {
                                            text: entry.replacement
                                                + (entry.variations > 1 ? " \u{00b7} " + entry.variations + " variations" : "");
                                            color: Theme.warning;
                                            font-size: 10px;
                                            overflow: elide;
                                        }

                                        if entry.replacement == "" && (entry.variations > 1 || entry.shared > 0 || entry.warning) : Text {
                                            text: (entry.variations > 1 ? entry.variations + " variations" : "")
                                                + (entry.variations > 1 && entry.shared > 0 ? " \u{00b7} " : "")
                                                + (entry.shared > 0 ? "shares audio with " + entry.shared + (entry.shared == 1 ? " other sound" : " other sounds") : "")
                                                + (entry.warning ? ((entry.variations > 1 || entry.shared > 0) ? " \u{00b7} " : "") + "may not replace cleanly" : "");
                                            color: entry.warning ? Theme.warning : Theme.text-muted;
                                            font-size: 10px;
                                            overflow: elide;
                                        }
                                    }
                                }

                                Text {
                                    width: root.is-music-tab ? 70px : 168px;
                                    text: root.is-music-tab
                                        ? (entry.replacement != "" ? "" : entry.size)
                                        : entry.detail;
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    horizontal-alignment: root.is-music-tab ? right : left;
                                    overflow: elide;
                                }

                                Text {
                                    width: 80px;
                                    text: entry.status;
                                    color: entry.status == "vanilla" ? Theme.text-muted
                                        : entry.status == "replace" ? Theme.warning
                                        : Theme.success;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }

                                Rectangle {
                                    width: 136px;
                                    horizontal-stretch: 0;

                                    HorizontalLayout {
                                        spacing: 4px;
                                        alignment: end;

                                        if entry.can-play : Button {
                                            text: entry.event == root.playing-event && root.playing-variation < 1 ? "Stop" : "Play";
                                            width: 50px;
                                            height: 26px;
                                            clicked => {
                                                if (entry.event == root.playing-event && root.playing-variation < 1) {
                                                    root.stop-playback();
                                                } else {
                                                    root.play-track(entry.event);
                                                }
                                            }
                                        }

                                        if entry.status != "replace" : Button {
                                            text: "Replace";
                                            width: 78px;
                                            height: 26px;
                                            enabled: !root.build-running;
                                            clicked => { root.replace-track(entry.event); }
                                        }

                                        if entry.status != "vanilla" : Button {
                                            text: "Remove";
                                            width: 78px;
                                            height: 26px;
                                            enabled: !root.build-running;
                                            clicked => { root.remove-staged(entry.event); }
                                        }
                                    }
                                }
                            }

                            // ---------------- variation row ----------------
                            if entry.kind == 1 : HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;

                                Text {
                                    width: root.is-music-tab ? 80px : 104px;
                                    text: "\u{21b3} " + entry.group;
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 1px;

                                    Text {
                                        text: entry.name;
                                        color: entry.event == root.playing-event && root.playing-variation == entry.variation ? Theme.success : Theme.text-secondary;
                                        font-size: 11px;
                                        font-family: "Consolas";
                                        font-weight: entry.event == root.playing-event && root.playing-variation == entry.variation ? 700 : 400;
                                        overflow: elide;
                                    }

                                    if entry.replacement != "" : Text {
                                        text: entry.replacement;
                                        color: Theme.warning;
                                        font-size: 10px;
                                        overflow: elide;
                                    }

                                    if entry.replacement == "" && entry.shared > 0 : Text {
                                        text: "shares audio with " + entry.shared + (entry.shared == 1 ? " other sound" : " other sounds");
                                        color: Theme.text-muted;
                                        font-size: 10px;
                                        overflow: elide;
                                    }
                                }

                                Text {
                                    width: root.is-music-tab ? 70px : 168px;
                                    text: entry.detail;
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    horizontal-alignment: root.is-music-tab ? right : left;
                                    overflow: elide;
                                }

                                Text {
                                    width: 80px;
                                    text: entry.status;
                                    color: entry.status == "vanilla" ? Theme.text-muted : Theme.warning;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }

                                Rectangle {
                                    width: 136px;
                                    horizontal-stretch: 0;

                                    HorizontalLayout {
                                        spacing: 4px;
                                        alignment: end;

                                        if entry.can-play : Button {
                                            text: entry.event == root.playing-event && root.playing-variation == entry.variation ? "Stop" : "Play";
                                            width: 50px;
                                            height: 26px;
                                            clicked => {
                                                if (entry.event == root.playing-event && root.playing-variation == entry.variation) {
                                                    root.stop-playback();
                                                } else {
                                                    root.play-variation(entry.event, entry.variation);
                                                }
                                            }
                                        }

                                        if entry.status != "replace" : Button {
                                            text: "Replace";
                                            width: 78px;
                                            height: 26px;
                                            enabled: !root.build-running;
                                            clicked => { root.replace-variation(entry.event, entry.variation); }
                                        }

                                        if entry.status != "vanilla" : Button {
                                            text: "Remove";
                                            width: 78px;
                                            height: 26px;
                                            enabled: !root.build-running;
                                            clicked => { root.remove-variation(entry.event, entry.variation); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ---------------- paging footer ----------------
                    if root.tab-total > 0 : HorizontalLayout {
                        height: 30px;
                        vertical-stretch: 0;
                        spacing: 8px;

                        Text {
                            horizontal-stretch: 1;
                            text: "Sounds " + root.page-first + "\u{2013}" + root.page-last + " of " + root.tab-total
                                + (root.search-text != "" ? " matching \"" + root.search-text + "\"" : "");
                            color: Theme.text-muted;
                            font-size: 11px;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Button {
                            text: "\u{2039} Prev";
                            width: 70px;
                            height: 26px;
                            enabled: root.page-index > 0;
                            clicked => { root.prev-page(); }
                        }

                        Text {
                            text: "Page " + (root.page-index + 1) + " of " + root.page-count;
                            color: Theme.text-secondary;
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        Button {
                            text: "Next \u{203a}";
                            width: 70px;
                            height: 26px;
                            enabled: root.page-index + 1 < root.page-count;
                            clicked => { root.next-page(); }
                        }
                    }

                    if root.is-playing : Rectangle {
                        height: 72px;
                        vertical-stretch: 0;
                        background: Theme.surface-muted;
                        border-color: Theme.border;
                        border-width: 1px;
                        border-radius: 6px;

                        VerticalLayout {
                            padding: 12px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 8px;

                            HorizontalLayout {
                                height: 28px;
                                vertical-stretch: 0;
                                spacing: 8px;

                                // Pause / Play button
                                Rectangle {
                                    width: 32px;
                                    height: 28px;
                                    horizontal-stretch: 0;
                                    border-radius: 5px;
                                    background: pause-touch.pressed ? Theme.action-pressed
                                        : pause-touch.has-hover ? Theme.action-hover
                                        : Theme.action;
                                    border-width: 1px;
                                    border-color: Theme.action-border;

                                    if root.playing-paused : Path {
                                        x: 12px;
                                        y: 7px;
                                        width: 12px;
                                        height: 14px;
                                        fill: #ffffff;
                                        commands: "M 0 0 L 12 7 L 0 14 Z";
                                    }

                                    if !root.playing-paused : HorizontalLayout {
                                        padding-left: 9px;
                                        padding-right: 9px;
                                        padding-top: 6px;
                                        padding-bottom: 6px;
                                        spacing: 3px;

                                        Rectangle {
                                            width: 4px;
                                            background: #ffffff;
                                            border-radius: 1px;
                                        }
                                        Rectangle {
                                            width: 4px;
                                            background: #ffffff;
                                            border-radius: 1px;
                                        }
                                    }

                                    pause-touch := TouchArea {
                                        clicked => { root.toggle-pause(); }
                                    }
                                }

                                // Stop button
                                Rectangle {
                                    width: 32px;
                                    height: 28px;
                                    horizontal-stretch: 0;
                                    border-radius: 5px;
                                    background: stop-touch.pressed ? Theme.danger-action-pressed
                                        : stop-touch.has-hover ? Theme.danger-action-hover
                                        : Theme.danger-action;
                                    border-width: 1px;
                                    border-color: Theme.danger-border;

                                    Rectangle {
                                        x: 10px;
                                        y: 8px;
                                        width: 12px;
                                        height: 12px;
                                        background: #ffffff;
                                        border-radius: 2px;
                                    }

                                    stop-touch := TouchArea {
                                        clicked => { root.stop-playback(); }
                                    }
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: root.playing-filename;
                                    color: Theme.success;
                                    font-size: 13px;
                                    font-weight: 600;
                                    font-family: "Consolas";
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                Text {
                                    text: root.playing-position-text + " / " + root.playing-duration-text;
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                    font-family: "Consolas";
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }
                            }

                            Rectangle {
                                height: 14px;
                                vertical-stretch: 0;
                                background: Theme.surface-raised;
                                border-color: Theme.border;
                                border-width: 1px;
                                border-radius: 7px;

                                Rectangle {
                                    x: 1px;
                                    y: 1px;
                                    width: max(0px, (parent.width - 2px) * root.playing-progress);
                                    height: parent.height - 2px;
                                    background: Theme.success;
                                    border-radius: 6px;
                                }

                                Rectangle {
                                    x: max(1px, (parent.width - 2px) * root.playing-progress - 6px);
                                    y: -2px;
                                    width: 18px;
                                    height: 18px;
                                    border-radius: 9px;
                                    background: #ffffff;
                                    border-color: Theme.success;
                                    border-width: 2px;
                                    visible: root.playing-progress > 0.001;
                                }

                                seek-area := TouchArea {
                                    clicked => {
                                        root.seek-to(self.mouse-x / self.width);
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        min-height: 160px;
                        max-height: 200px;
                        vertical-stretch: 0;
                        background: Theme.terminal;
                        border-color: Theme.border;
                        border-width: 1px;
                        border-radius: 6px;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;

                            HorizontalLayout {
                                height: 28px;
                                vertical-stretch: 0;
                                spacing: 10px;

                                Text {
                                    horizontal-stretch: 1;
                                    text: "Activity log";
                                    color: Theme.text-primary;
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }

                                Button {
                                    text: "Copy";
                                    width: 62px;
                                    enabled: root.log-text != "";
                                    clicked => { root.copy-log(); }
                                }

                                if root.build-complete : Button {
                                    text: "Open output";
                                    width: 100px;
                                    clicked => { root.open-output(); }
                                }
                            }

                            live-log := TextEdit {
                                vertical-stretch: 1;
                                text: root.log-text;
                                read-only: true;
                                wrap: word-wrap;
                                font-size: 12px;
                                accessible-label: "Activity log";
                                placeholder-text: "Activity will appear here.";
                            }
                        }
                    }
                }
            }
        }
    }

    // Copyright reminder, shown on top of everything before Export / Package.
    if root.export-warning-visible : Rectangle {
        background: #000000b0;

        // Swallow clicks so the UI underneath is inert while the warning is up.
        TouchArea { }

        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 560px;
                    background: Theme.surface;
                    border-color: Theme.warning;
                    border-width: 1px;
                    border-radius: 8px;

                    VerticalLayout {
                        padding: 22px;
                        spacing: 12px;

                        Text {
                            text: "Before you share this mod";
                            color: Theme.warning;
                            font-size: 18px;
                            font-weight: 650;
                        }

                        Text {
                            text: "Be careful when uploading music mods. Only share music you have the rights to: tracks you own the copyright to, music the rights holder has explicitly allowed you to redistribute, or music that is free to use (royalty-free, Creative Commons, public domain or a similar open license - check the terms, many require credit). Sharing copyrighted music without permission can result in takedown notices, account strikes, or legal action against you.";
                            color: Theme.text-primary;
                            font-size: 13px;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "The developer of OBR Music Tool accepts no responsibility for takedown notices, account actions, or any other legal consequences arising from content you create or distribute with it. By continuing, you confirm that you have the necessary rights.";
                            color: Theme.text-secondary;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            dont-show-again := CheckBox {
                                horizontal-stretch: 1;
                                text: "Don't show this again";
                            }

                            Button {
                                text: "Cancel";
                                width: 90px;
                                clicked => {
                                    root.export-warning-visible = false;
                                    root.pending-export = "";
                                }
                            }

                            PrimaryButton {
                                text: "I understand, continue";
                                width: 210px;
                                clicked => {
                                    if (dont-show-again.checked) {
                                        root.export-warning-dismissed = true;
                                        root.export-warning-dismiss();
                                    }
                                    root.export-warning-visible = false;
                                    root.run-export(root.pending-export);
                                    root.pending-export = "";
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
